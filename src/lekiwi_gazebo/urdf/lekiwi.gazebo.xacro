<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Gazebo-only additions for the LeKiwi robot:
      - PlanarMove drive plugin (holonomic, accepts /cmd_vel as Twist)
      - GPU LiDAR sensor on laser_frame, publishes /scan
      - Material colors for visuals so the model is not pure grey in Gazebo
  -->

  <xacro:macro name="lekiwi_gazebo">

    <!-- Holonomic drive: reads geometry_msgs/Twist on /cmd_vel and applies it
         directly to the model's linear/angular velocity. PlanarMove is gone in
         Harmonic; VelocityControl is the modern equivalent and supports holo. -->
    <gazebo>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>cmd_vel</topic>
      </plugin>
    </gazebo>

    <!-- Odometry publisher: emits /odom and /tf from base_footprint pose -->
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_publish_frequency>30</odom_publish_frequency>
        <odom_topic>odom</odom_topic>
        <tf_topic>tf</tf_topic>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>

    <gazebo reference="laser_frame">
      <sensor name="laser" type="gpu_lidar">
        <topic>scan</topic>
        <update_rate>5</update_rate>
        <gz_frame_id>laser_frame</gz_frame_id>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <!-- Visual material overrides for Gazebo (URDF visuals reference RViz materials only) -->
    <gazebo reference="base_link">
      <material>
        <ambient>0.8 0.8 0.8 1</ambient>
        <diffuse>0.8 0.8 0.8 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </gazebo>
    <gazebo reference="laser_link">
      <material>
        <ambient>0.15 0.15 0.15 1</ambient>
        <diffuse>0.15 0.15 0.15 1</diffuse>
      </material>
    </gazebo>
    <gazebo reference="left_wheel_link">
      <material>
        <ambient>0.15 0.15 0.15 1</ambient>
        <diffuse>0.15 0.15 0.15 1</diffuse>
      </material>
    </gazebo>
    <gazebo reference="back_wheel_link">
      <material>
        <ambient>0.15 0.15 0.15 1</ambient>
        <diffuse>0.15 0.15 0.15 1</diffuse>
      </material>
    </gazebo>
    <gazebo reference="right_wheel_link">
      <material>
        <ambient>0.15 0.15 0.15 1</ambient>
        <diffuse>0.15 0.15 0.15 1</diffuse>
      </material>
    </gazebo>

  </xacro:macro>

</robot>
