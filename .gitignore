# colcon build artifacts
/build/
/install/
/log/
active.log

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Editor / OS clutter
.vscode/
.idea/
.DS_Store
*.swp
*~

# Real-robot driver, kept as a separate upstream clone (has its own .git).
# Re-clone with: git clone https://github.com/adityakamath/sts_hardware_interface
# into src/ when targeting the physical robot.
/src/sts_hardware_interface/

# Frontier explorer for active SLAM (upstream clone, has its own .git).
# Re-clone with: git clone https://github.com/robo-friends/m-explore-ros2 into src/
/src/m-explore-ros2/

# YOLO ROS 2 wrapper (upstream clone, has its own .git).
# Re-clone with: git clone https://github.com/mgonzs13/yolo_ros into src/
/src/yolo_ros/

# YOLO model weights — auto-downloaded by Ultralytics on first inference.
yolov8*.pt
yolo11*.pt
yolov8*-world.pt

# Generated map artifacts (regenerated by SLAM runs).
# Keep the world-aligned placeholder + checked-in apartment map; ignore PNGs.
src/lekiwi_ros2/lekiwi_navigation/maps/*.png
lekiwi_ros2/lekiwi_description/meshes/base/lekiwi_base_old.stl
